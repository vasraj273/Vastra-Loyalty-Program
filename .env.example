# Vastra Loyalty Program - environment variables
#
# IMPORTANT: the app itself has NO dotenv loader - no load_dotenv() call
# anywhere, so importing app.main does NOT read this file. Pass it to uvicorn
# instead (uvicorn[standard] bundles python-dotenv, so --env-file works):
#
#   cp .env.example .env
#   .venv/bin/uvicorn app.main:app --port 8000 --env-file .env
#
# For anything that is NOT uvicorn (seed.py, import_retailers.py, pytest,
# psql), --env-file does not apply - export into the shell instead:
#
#   set -a; source .env; set +a       # zsh/bash
#   .venv/bin/python seed.py
#
# DEPLOYMENT: .env is gitignored and is NOT part of the Docker image, so none
# of this reaches Render. Every variable you rely on in production must be
# entered in Render's own Environment tab, or that feature fails closed there
# while working fine locally. See DEPLOY.md.
#
# Every variable below is OPTIONAL. With none set, the app runs locally on
# SQLite with password login and all integrations failing closed - which is
# the normal local-dev setup. Values shown are the in-code defaults.


# ---------------------------------------------------------------- database
# MySQL connection string. UNSET -> local SQLite file ./qr_api.db (no setup
# needed). Requires MySQL 8.0.13+ with utf8mb4; add ?ssl=true for TLS (or
# ?ssl_ca=/path/to/global-bundle.pem to verify the RDS certificate too).
# A postgres:// URL is rejected at boot with an explicit message.
# See app/database.py and docs/integration/MYSQL_SETUP.md
# DATABASE_URL=mysql://user:pass@host:3306/vastra_loyalty?ssl=true


# ------------------------------------------------------------------- QR
# URL prefix baked into every generated QR payload ({QR_BASE_URL}/{token}).
# MUST point at the deployed HTTPS origin before any production print run,
# or printed stickers resolve to the wrong host. See app/qr_service.py
QR_BASE_URL=http://127.0.0.1:8000/web/scan


# ---------------------------------------------- native-app SSO (Vastra/YourApp)
# Shared HMAC secret for the HS256 JWT token exchange
# (POST /auth/sso/manufacturer, POST /auth/sso/retailer).
# UNSET -> both SSO endpoints return 503 and are otherwise inert.
# SECRET - use a long random string, never commit the real value.
# SSO_SECRET=
SSO_ISSUERS=vastra,yourapp
SSO_AUDIENCE=loyalty
# Max assertion age in seconds (bounds replay via an iat freshness check).
SSO_MAX_AGE=120


# ------------------------------------------------------- product catalog
# The catalog is the manufacturer's own CSV import (POST /catalog/products/
# import). USE_SAMPLE_PRODUCTS=1 makes GET /catalog/products fall back to three
# built-in demo products while a manufacturer has imported nothing yet, so the
# QR-generate -> scan -> redeem flow is testable without a CSV.
# DEFAULTS TO 0 (off), so a deployment is go-live safe with the variable unset:
# the Products tab shows "No products yet - add them using the Import CSV
# button" instead of demo rows. Set it to 1 only for local dev and demos.
USE_SAMPLE_PRODUCTS=1


# ------------------------------------------------- Vastra API (OTP login)
# Vastra's API origin, called SERVER-SIDE ONLY via app/vastra_client.py.
# Powers the panel's Vastra mobile+OTP login.
# UNSET -> OTP login fails closed with 502 (password login still works).
# NOTE: this does NOT affect the product catalog - Vastra's product API is not
# a catalog source (get-design-ids returns no product names).
# VASTRA_API_BASE_URL=https://<vastra-host>/api/v2
# Sent as the `api-key` header. Staging value is "1" (not secret);
# confirm the production key with Vastra's team.
VASTRA_API_KEY=1
VASTRA_API_TIMEOUT=10
# Fixed device headers Vastra requires; defaults are accepted.
VASTRA_UDID=loyalty-backend
VASTRA_DEVICE_TYPE=android


# --------------------------------------- YourApp server-to-server scan
# Shared secret for POST /yourapp/qr/lookup and POST /yourapp/scan
# (sent by YourApp's backend in the X-API-Key header).
# UNSET -> both endpoints return 503.
# SECRET - long random string, server-side only, NEVER in a mobile build.
# YOURAPP_API_KEY=


# ------------------------------------------------------------ rate limiting
# Set RL_ENABLED=0 to disable entirely (the test suite does this).
RL_ENABLED=1
RL_LOGIN=10/minute
RL_SCAN=60/minute
RL_CLAIM=20/minute
RL_QRGEN=30/minute
RL_IMPORT=10/hour
# Shared backend for limit counters (e.g. redis://...). UNSET -> in-memory,
# which is per-process only and resets on restart. See app/main.py
# RL_STORAGE_URI=


# ------------------------------------------------------- destructive-op guard
# seed.py / seed_extra.py refuse to touch a MySQL DB unless ALLOW_MYSQL=1.
# Leave unset. Only pass it deliberately, and never against real data.
# ALLOW_MYSQL=1
